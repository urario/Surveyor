<Project>
  <PropertyGroup>
    <SurveyorCoreTargetFramework>net10.0</SurveyorCoreTargetFramework>
    <SurveyorWindowsTargetFramework>net10.0-windows10.0.19041.0</SurveyorWindowsTargetFramework>
    <SurveyorIsSourceProject>false</SurveyorIsSourceProject>
    <SurveyorIsSourceProject Condition="'$(MSBuildProjectName)' == 'Surveyor.Domain' Or '$(MSBuildProjectName)' == 'Surveyor.Application' Or '$(MSBuildProjectName)' == 'Surveyor.Policy' Or '$(MSBuildProjectName)' == 'Surveyor.Reports' Or '$(MSBuildProjectName)' == 'Surveyor.Adapters.Discovery' Or '$(MSBuildProjectName)' == 'Surveyor.Adapters.Uia.Audit' Or '$(MSBuildProjectName)' == 'Surveyor.Adapters.Uia' Or '$(MSBuildProjectName)' == 'Surveyor.Adapters.Capture' Or '$(MSBuildProjectName)' == 'Surveyor.Adapters.Store' Or '$(MSBuildProjectName)' == 'Surveyor.Presentation' Or '$(MSBuildProjectName)' == 'Surveyor.App'">true</SurveyorIsSourceProject>

    <!-- CS-07: core-layer test projects fail below 80% line coverage; other layers only report. -->
    <SurveyorIsCoreTestProject>false</SurveyorIsCoreTestProject>
    <SurveyorIsCoreTestProject Condition="'$(MSBuildProjectName)' == 'Surveyor.Domain.Tests' Or '$(MSBuildProjectName)' == 'Surveyor.Application.Tests' Or '$(MSBuildProjectName)' == 'Surveyor.Policy.Tests' Or '$(MSBuildProjectName)' == 'Surveyor.Reports.Tests'">true</SurveyorIsCoreTestProject>
    <TargetFramework>$(SurveyorCoreTargetFramework)</TargetFramework>
    <TargetFramework Condition="'$(MSBuildProjectName)' == 'Surveyor.Adapters.Discovery' Or '$(MSBuildProjectName)' == 'Surveyor.Adapters.Uia' Or '$(MSBuildProjectName)' == 'Surveyor.Adapters.Uia.Tests' Or '$(MSBuildProjectName)' == 'Surveyor.Adapters.Capture' Or '$(MSBuildProjectName)' == 'Surveyor.Adapters.Store' Or '$(MSBuildProjectName)' == 'Surveyor.Presentation' Or '$(MSBuildProjectName)' == 'Surveyor.App'">$(SurveyorWindowsTargetFramework)</TargetFramework>

    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-All</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile Condition="'$(SurveyorIsSourceProject)' == 'true'">true</GenerateDocumentationFile>
    <GenerateDocumentationFile Condition="'$(SurveyorIsSourceProject)' != 'true'">false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CI)' == 'true' Or '$(ContinuousIntegrationBuild)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)CodeMetricsConfig.txt" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Surveyor.Domain' Or '$(MSBuildProjectName)' == 'Surveyor.Application'">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)eng\analyzers\BannedSymbols.Core.txt" />
  </ItemGroup>

  <ItemGroup Condition="'$(SurveyorIsSourceProject)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>$(AssemblyName).Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Surveyor.TestSupport</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- CS-07: a plain `dotnet test` on a core-layer test project collects coverage via
       coverlet.msbuild and fails the run when total line coverage drops below 80%, so the
       threshold is enforced by the command itself rather than by a self-reported number. -->
  <PropertyGroup Condition="'$(SurveyorIsCoreTestProject)' == 'true'">
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
    <CoverletOutput>$(MSBuildProjectDirectory)/../../artifacts/coverage/$(MSBuildProjectName)/</CoverletOutput>
    <CoverletIncludeFilter Condition="'$(MSBuildProjectName)' == 'Surveyor.Domain.Tests'">[Surveyor.Domain]*</CoverletIncludeFilter>
    <CoverletIncludeFilter Condition="'$(MSBuildProjectName)' == 'Surveyor.Application.Tests'">[Surveyor.Application]*</CoverletIncludeFilter>
    <CoverletIncludeFilter Condition="'$(MSBuildProjectName)' == 'Surveyor.Policy.Tests'">[Surveyor.Policy]*</CoverletIncludeFilter>
    <CoverletIncludeFilter Condition="'$(MSBuildProjectName)' == 'Surveyor.Reports.Tests'">[Surveyor.Reports]*</CoverletIncludeFilter>
    <Include>$(CoverletIncludeFilter)</Include>
    <Threshold>80</Threshold>
    <ThresholdType>line</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
  </PropertyGroup>

  <ItemGroup Condition="'$(SurveyorIsCoreTestProject)' == 'true'">
    <PackageReference Include="coverlet.msbuild" PrivateAssets="all" />
  </ItemGroup>
</Project>
